PORT=4000

# Supabase: click the green "Connect" button at the top of your project dashboard,
# then choose the "Session pooler" tab (NOT "Direct connection" — that one requires
# IPv6, which most home/office networks don't support). Copy that string here and
# replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
